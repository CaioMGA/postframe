{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.7.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*",
    "https://cdn.bsky.app/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://i.redd.it/*",
    "https://preview.redd.it/*",
    "https://external-preview.redd.it/*",
    "https://styles.redditmedia.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/sites/x.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bsky.app/*"
      ],
      "js": [
        "src/sites/bluesky.js",
        "src/sites/bluesky-page.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "default_locale": "en"
}
